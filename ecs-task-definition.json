{
  "family": "cloud-cicd-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::560396669076:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "cloud-cicd-container",
      "image": "560396669076.dkr.ecr.eu-west-2.amazonaws.com/cloud-cicd-app:latest",
      "portMappings": [{ "containerPort": 80, "protocol": "tcp" }]
    }
  ]
}
